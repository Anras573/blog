---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, slugifyTag, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const byTag = new Map<string, { name: string; posts: Post[] }>();
  for (const post of posts) {
    for (const name of post.data.tags) {
      const slug = slugifyTag(name);
      const entry = byTag.get(slug) ?? { name, posts: [] };
      entry.posts.push(post);
      byTag.set(slug, entry);
    }
  }
  return [...byTag].map(([tag, { name, posts }]) => ({ params: { tag }, props: { name, posts } }));
}
const { name, posts } = Astro.props;
---
<Base title={`#${name}`} description={`Posts tagged ${name}`}>
  <h1>#{name}</h1>
  <PostList posts={posts} />
</Base>

---
import { SITE_TITLE, url } from '../consts';
const path = Astro.url.pathname;
const links = [
  { href: url(), label: 'Writing' },
  { href: url('tags/'), label: 'Tags' },
  { href: url('about/'), label: 'About' },
];
const isActive = (href: string) => (href === url() ? path === href : path.startsWith(href));
---
<header class="site-header">
  <a class="brand" href={url()}>{SITE_TITLE}</a>
  <nav aria-label="Main">
    {links.map((l) => (
      <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
    <a href={url('rss.xml')}>RSS</a>
    <button id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle theme">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z" />
      </svg>
    </button>
  </nav>
</header>
<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>
